{
  "_comment": "ガチャ発売ラインアップの自動収集ソース。urls は最初に読むページ、url_templates は {yyyy} {mm} {m} を months_back か月前〜months_ahead か月先で展開して読むページ、max_pages は1ソースで読む最大ページ数。item_href は商品ページへのリンクとみなすURLの正規表現（指定すると、価格のないカードも直前の見出しの入荷めどで拾う）。follow を書くとページ内のリンクのうち一致するものも辿る。enabled を false にすると収集しない。",
  "sources": [
    {
      "key": "bandai",
      "name": "ガシャポン（バンダイ）",
      "maker": "バンダイ",
      "link": "https://gashapon.jp/schedule/",
      "urls": [
        "https://gashapon.jp/schedule/"
      ],
      "max_pages": 6,
      "hosts": [
        "gashapon.jp",
        "www.gashapon.jp"
      ],
      "item_href": "/products/detail\\.php",
      "enabled": true,
      "url_templates": [
        "https://gashapon.jp/schedule/?ym={yyyy}{mm}"
      ],
      "months_back": 1,
      "months_ahead": 2
    },
    {
      "key": "tta",
      "name": "ガチャ（タカラトミーアーツ）",
      "maker": "タカラトミーアーツ",
      "link": "https://www.takaratomy-arts.co.jp/items/gacha/calendar/",
      "urls": [
        "https://www.takaratomy-arts.co.jp/items/gacha/calendar/"
      ],
      "max_pages": 6,
      "hosts": [
        "www.takaratomy-arts.co.jp"
      ],
      "item_href": "/items/item\\.html\\?n=",
      "enabled": true,
      "url_templates": [
        "https://www.takaratomy-arts.co.jp/items/gacha/calendar/?ym={yyyy}{mm}"
      ],
      "months_back": 1,
      "months_ahead": 2
    }
  ]
}
